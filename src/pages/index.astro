---
import Page from '../layouts/Page.astro';
import GameCard from '../components/GameCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PlayPoster from '../components/PlayPoster.astro';
import {
	COMPANY,
	CONTACT_EMAIL,
	SITE_DESCRIPTION,
	SITE_TAGLINE,
	SITE_TITLE,
	SITE_URL,
} from '../consts';
import { FEATURED, GAMES, RELEASED, TANK_MORPHS, UPCOMING, WITH_TRAILERS, gameUrl } from '../data/games';

const bySlug = (slug: string) => GAMES.find((g) => g.slug === slug)!;
// The three pieces of artwork fanned out in the hero, back to front.
const heroArt = ['capy-sports-club', 'axolotl-colouring', 'axolotl-chase'].map(bySlug);
const [lead, ...restFeatured] = FEATURED;
const tank = bySlug('axolotl-tank');

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	legalName: COMPANY,
	url: SITE_URL,
	logo: `${SITE_URL}/favicon.svg`,
	email: CONTACT_EMAIL,
	description: SITE_DESCRIPTION,
};
---

<Page title={`${SITE_TITLE} | Family-made indie games. ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} jsonLd={jsonLd} wide>
	<!-- Hero -->
	<section class="hero on-dark">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">Independent games studio</p>
				<h1>Little worlds.<br /> <span class="accent">Big adventures.</span></h1>
				<p class="hero-lede">
					Discover original games and creative experiences made with imagination, for curious
					minds and families.
				</p>
				<div class="hero-actions">
					<a class="btn btn--glow" href="#games">Explore our games <span aria-hidden="true">↓</span></a>
					<a class="btn btn--ghost" href="#coming-soon">See what's coming</a>
				</div>
				<p class="hero-note">
					<span>{RELEASED.length} games and apps out now</span>
					<span>No ads, no accounts</span>
				</p>
			</div>
			<div class="fan" aria-hidden="true">
				{heroArt.map((g, i) => (
					<div class={`fan-card fan-${i + 1}`}>
						<img
							src={g.artSmall}
							alt=""
							width="800"
							height="450"
							loading="eager"
							decoding="async"
							fetchpriority={i === heroArt.length - 1 ? 'high' : undefined}
						/>
					</div>
				))}
				<span class="bubble b1"></span>
				<span class="bubble b2"></span>
				<span class="bubble b3"></span>
			</div>
		</div>
	</section>

	<!-- Featured games -->
	<section id="games" class="section featured" aria-labelledby="featured-title">
		<div class="container">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Featured</p>
				<h2 id="featured-title">Start your adventure here</h2>
				<p>Three favourites from the studio. Press play on a trailer, or dive straight in.</p>
			</div>
			<div class="featured-grid">
				<div class="lead-slot" data-reveal><FeatureCard game={lead} lead /></div>
				{restFeatured.map((g) => (
					<div data-reveal><FeatureCard game={g} /></div>
				))}
			</div>
		</div>
	</section>

	<!-- The full catalogue -->
	<section id="catalogue" class="section section--tint" aria-labelledby="catalogue-title">
		<div class="container">
			<div class="section-head" data-reveal>
				<p class="eyebrow">The catalogue</p>
				<h2 id="catalogue-title">All our games</h2>
				<p>Everything we've released so far, with more on the way.</p>
			</div>
			<ul class="catalogue">
				{RELEASED.map((g) => (
					<li data-reveal><GameCard game={g} /></li>
				))}
				{UPCOMING.map((g) => (
					<li data-reveal><GameCard game={g} /></li>
				))}
			</ul>
		</div>
	</section>

	<!-- Coming soon: Axolotl Tank -->
	<section id="coming-soon" class="soon on-dark" aria-labelledby="tank-title">
		<div class="soon-art">
			<img
				src={tank.art}
				alt={tank.artAlt}
				width={tank.artWidth}
				height={tank.artHeight}
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="container soon-body">
			<div class="soon-copy" data-reveal>
				<p class="soon-flags"><span class="flag flag--soon">Coming soon</span> <span class="soon-genre">{tank.genre}</span></p>
				<h2 id="tank-title" class="wordmark">Axolotl <span>Tank</span></h2>
				<p class="soon-headline">{tank.tagline}</p>
				<p class="soon-text">{tank.summary}</p>
				<a class="btn btn--glow" href={gameUrl(tank)}>Take a first look <span aria-hidden="true">→</span></a>
			</div>
		</div>
		<div class="container">
			<ul class="morphs" aria-label="Some of the axolotls to collect in Axolotl Tank" data-reveal>
				{TANK_MORPHS.map((m) => (
					<li>
						<img src={m.src} alt="" width="640" height="360" loading="lazy" decoding="async" />
						<span>{m.name}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Also in the lab: Piglet's Surgery -->
	<section class="section lab" aria-labelledby="piglets-surgery">
		<div class="container">
			<article class="teaser" data-reveal>
				<a class="teaser-art" href="/art/piglets-surgery.webp" data-zoom aria-label="See the Piglet's Surgery artwork full size">
					<img
						src="/art/piglets-surgery.webp"
						alt="Piglet's Surgery artwork: Dr Piglet, a pink plush pig in a white coat, operates on Bart the blobfish while Big Bunny the chief nurse covers her eyes, two owls called Choccy and Icey watch, and Raaaar the dinosaur knocks things over. Below, Piglet shouts 'Just give him a… SHHHOTTT!!!' at Pip the avocado, then does frantic CPR as things escalate quickly."
						width="1774"
						height="887"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<div class="teaser-body">
					<p class="eyebrow">Also in the lab</p>
					<h2 id="piglets-surgery">Piglet's Surgery</h2>
					<p class="teaser-tagline">The world's least relaxing doctor's surgery!</p>
					<p>
						Dr Piglet is very enthusiastic. Dr Piglet is also a bit risky. Examine some very
						strange patients, make questionable decisions with real (toy) equipment and keep the
						surgery running while Big Bunny, the long-suffering chief nurse, tries to hold it all
						together. Every choice can make things better… or much, much worse.
					</p>
					<p class="checklist" aria-label="How it goes">
						<span>Examine.</span> <span>Treat.</span> <span>Panic.</span> <span>(Maybe) save.</span>
					</p>
					<a class="btn" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Piglet's Surgery tester")}`}>
						Be a test patient <span aria-hidden="true">→</span>
					</a>
					<p class="fine">Want to try it before anyone else? Drop us a line and we'll let you know when testing starts.</p>
				</div>
			</article>
		</div>
	</section>

	<!-- Trailers -->
	<section id="trailers" class="section watch on-dark" aria-labelledby="watch-title">
		<div class="container">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Watch</p>
				<h2 id="watch-title">See them in action</h2>
				<p>Trailers and gameplay from across the studio.</p>
			</div>
			<ul class="reel">
				{WITH_TRAILERS.map((g) => (
					<li data-reveal>
						<div class="reel-frame"><PlayPoster trailer={g.trailer!} /></div>
						<p><a href={gameUrl(g)}>{g.name}</a> <span>{g.genre}</span></p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- About -->
	<section id="about" class="section about" aria-labelledby="about-title">
		<div class="container about-grid">
			<div data-reveal>
				<p class="eyebrow">About us</p>
				<h2 id="about-title">Big ideas, imaginative worlds and games made for families.</h2>
				<p class="motto">Designed by kids. <span>Engineered by adults.</span></p>
			</div>
			<div class="about-copy" data-reveal>
				<p class="big">BioLuma Labs is a family-led independent games studio based in the UK.</p>
				<p>
					We make things because we think they're fun, interesting or useful. Some ideas come from
					us. Some come from our kids. Some start as a ridiculous conversation at the dinner table.
				</p>
				<p>
					Whatever the origin, we build them properly, and if they're good enough, we put them out
					into the world.
				</p>
				<ul class="values" aria-label="What we aim for">
					<li>Fun first</li>
					<li>Accessible</li>
					<li>Family-friendly</li>
					<li>Thoughtfully designed</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Contact -->
	<section id="contact" class="section contact" aria-labelledby="contact-title">
		<div class="container">
			<div class="contact-card on-dark" data-reveal>
				<img src="/favicon.svg" width="96" height="96" alt="" loading="lazy" />
				<div>
					<h2 id="contact-title">Say hello</h2>
					<p>
						Questions, ideas or a bug to report? Email us and a real person will reply.
					</p>
				</div>
				<div class="contact-actions">
					<a class="btn btn--glow" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
					<a class="btn btn--ghost" href="/support/">Get support</a>
				</div>
			</div>
		</div>
	</section>
</Page>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(60rem 34rem at 85% 10%, rgba(20, 167, 162, 0.35), transparent 65%),
			radial-gradient(40rem 26rem at 0% 100%, rgba(240, 143, 187, 0.12), transparent 70%),
			var(--navy-900);
		padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(4.5rem, 10vw, 7.5rem);
	}
	.hero-grid {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4rem);
		align-items: center;
	}
	.hero h1 {
		margin: 0 0 1.1rem;
		font-size: clamp(2.6rem, 1.4rem + 6vw, 5rem);
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.hero .accent {
		color: var(--glow);
	}
	.hero-lede {
		max-width: 32rem;
		margin: 0 0 1.75rem;
		color: var(--on-dark-2);
		font-size: clamp(1.05rem, 1rem + 0.5vw, 1.25rem);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.hero-note {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
		margin: 1.75rem 0 0;
		color: var(--on-dark-2);
		font-size: 0.9rem;
		font-weight: 600;
	}
	.hero-note span::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.5rem;
		border-radius: 50%;
		background: var(--glow);
		box-shadow: 0 0 10px var(--glow);
	}

	/* Three pieces of game artwork, fanned like cards on a table. */
	.fan {
		position: relative;
		width: min(100%, 34rem);
		aspect-ratio: 10 / 7;
		margin-inline: auto;
	}
	.fan-card {
		position: absolute;
		width: 66%;
		border-radius: clamp(0.75rem, 2vw, 1.25rem);
		overflow: hidden;
		border: 3px solid rgba(255, 255, 255, 0.92);
		box-shadow: 0 24px 50px -18px rgba(0, 0, 0, 0.7);
		animation: float 9s ease-in-out infinite;
	}
	.fan-card img {
		display: block;
		width: 100%;
		height: auto;
	}
	.fan-1 {
		top: 0;
		left: 0;
		--r: -7deg;
		transform: rotate(var(--r));
	}
	.fan-2 {
		top: 6%;
		right: 0;
		--r: 6deg;
		transform: rotate(var(--r));
		animation-delay: -3s;
	}
	.fan-3 {
		bottom: 0;
		left: 15%;
		width: 72%;
		--r: -1.5deg;
		transform: rotate(var(--r));
		animation-delay: -6s;
	}
	@keyframes float {
		0%, 100% { transform: rotate(var(--r)) translateY(0); }
		50% { transform: rotate(var(--r)) translateY(-8px); }
	}
	.bubble {
		position: absolute;
		border-radius: 50%;
		border: 2px solid rgba(124, 245, 208, 0.5);
		animation: float 7s ease-in-out infinite;
		--r: 0deg;
	}
	.b1 { width: 1.4rem; height: 1.4rem; top: -6%; right: 22%; }
	.b2 { width: 0.7rem; height: 0.7rem; top: 2%; right: 14%; animation-delay: -2s; }
	.b3 { width: 2rem; height: 2rem; bottom: 4%; right: 2%; border-color: rgba(240, 143, 187, 0.55); animation-delay: -4s; }

	@media (min-width: 60rem) {
		.hero-grid {
			grid-template-columns: 1fr 1.05fr;
		}
		.fan {
			width: 100%;
			max-width: 40rem;
		}
	}

	/* ---------- Featured ---------- */
	/* The paper rises over the hero with a soft rounded edge. */
	.featured {
		position: relative;
		margin-top: calc(-1 * var(--radius-l));
		border-radius: var(--radius-l) var(--radius-l) 0 0;
		background: var(--paper);
	}
	.featured-grid {
		display: grid;
		gap: 1.5rem;
	}
	.featured-grid > div {
		display: grid;
	}
	@media (min-width: 44rem) {
		.featured-grid {
			grid-template-columns: 1fr 1fr;
		}
		.lead-slot {
			grid-column: 1 / -1;
		}
	}
	@media (min-width: 62rem) {
		.featured-grid {
			grid-template-columns: 1.55fr 1fr;
			grid-template-rows: auto auto;
		}
		.lead-slot {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.lead-slot :global(.feature .poster) {
			aspect-ratio: 16 / 10;
		}
		.featured-grid > div:not(.lead-slot) :global(.summary) {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}

	/* ---------- Catalogue ---------- */
	.catalogue {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.catalogue li {
		display: grid;
		margin: 0;
	}
	@media (min-width: 62rem) {
		.catalogue {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* ---------- Coming soon: Axolotl Tank ---------- */
	.soon {
		position: relative;
		background: #052a33;
		padding-bottom: clamp(2.5rem, 6vw, 4rem);
	}
	.soon-art {
		position: relative;
	}
	.soon-art img {
		display: block;
		width: 100%;
		height: clamp(15rem, 52vw, 40rem);
		object-fit: cover;
		object-position: 62% 40%;
	}
	.soon-art::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 55%, #052a33 100%);
	}
	.soon-body {
		position: relative;
		margin-top: -3rem;
	}
	.soon-flags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 0.9rem;
	}
	.soon-genre {
		color: var(--on-dark-2);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.wordmark {
		margin: 0 0 0.5rem;
		font-size: clamp(3rem, 1.6rem + 7vw, 6rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.02em;
		color: #fff;
		text-shadow: 0 4px 0 rgba(3, 24, 36, 0.55), 0 12px 30px rgba(0, 0, 0, 0.45);
	}
	.wordmark span {
		color: #ffd66b;
	}
	.soon-headline {
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2rem);
		font-weight: 500;
		line-height: 1.2;
		color: var(--glow);
	}
	.soon-text {
		max-width: 32rem;
		margin: 0 0 1.5rem;
		font-size: 1.1rem;
		color: var(--on-dark);
	}
	@media (min-width: 56rem) {
		.soon-art::after {
			background:
				linear-gradient(to right, rgba(5, 42, 51, 0.92) 0%, rgba(5, 42, 51, 0.6) 34%, transparent 62%),
				linear-gradient(to bottom, transparent 72%, #052a33 100%);
		}
		.soon-body {
			position: absolute;
			inset: 0 0 auto;
			height: clamp(15rem, 52vw, 40rem);
			margin-top: 0;
			display: flex;
			align-items: center;
		}
		.soon-copy {
			max-width: 31rem;
		}
	}
	.morphs {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.5rem 0.75rem;
		margin: clamp(2rem, 5vw, 3rem) 0 0;
		padding: 0;
		list-style: none;
		text-align: center;
	}
	.morphs li {
		margin: 0;
	}
	.morphs img {
		display: block;
		width: 100%;
		height: auto;
		filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.35));
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.morphs li:hover img {
		transform: translateY(-4px) scale(1.05);
	}
	.morphs span {
		display: block;
		margin-top: 0.15rem;
		color: var(--on-dark-2);
		font-size: clamp(0.68rem, 0.55rem + 0.5vw, 0.85rem);
		font-weight: 650;
	}
	@media (min-width: 56rem) {
		.morphs {
			grid-template-columns: repeat(8, 1fr);
		}
	}

	/* ---------- Piglet's Surgery ---------- */
	.teaser {
		display: grid;
		max-width: 58rem;
		margin-inline: auto;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-1);
	}
	/* The artwork is full of lettering, so it is shown whole rather than cropped. */
	.teaser-art {
		display: block;
		background: #fdf3e3;
		cursor: zoom-in;
	}
	.teaser-art img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.teaser-body {
		padding: clamp(1.25rem, 4vw, 2.25rem);
	}
	.teaser-body h2 {
		margin: 0 0 0.2rem;
		font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.4rem);
	}
	.teaser-tagline {
		margin: 0 0 0.75rem;
		color: var(--pink-deep);
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 500;
	}
	.teaser-body > p:not(.teaser-tagline, .eyebrow, .checklist) {
		color: var(--ink-2);
	}
	.checklist {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.9rem;
		margin: 0.9rem 0 1.25rem;
		font-weight: 700;
	}
	.checklist span::before {
		content: "✓ ";
		color: var(--teal-600);
	}
	.checklist span:nth-child(3) {
		color: var(--pink-deep);
	}
	.teaser-body .fine {
		margin: 0.9rem 0 0;
		font-size: 0.88rem;
	}
	/* ---------- Trailers ---------- */
	.watch {
		background: var(--navy-900);
	}
	.watch .section-head p:last-child {
		color: var(--on-dark-2);
	}
	.reel {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 1.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.reel li {
		margin: 0;
	}
	.reel-frame {
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: 0 0 0 1px var(--line-dark), 0 18px 40px -20px rgba(0, 0, 0, 0.8);
	}
	.reel p {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.1rem 0.75rem;
		margin: 0.7rem 0.15rem 0;
	}
	.reel p a {
		color: var(--on-dark);
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 600;
		text-decoration: none;
	}
	.reel p a:hover {
		color: var(--glow);
		text-decoration: underline;
	}
	.reel p span {
		color: var(--on-dark-2);
		font-size: 0.8rem;
	}
	@media (min-width: 44rem) and (max-width: 71.99rem) {
		.reel {
			grid-template-columns: 1fr 1fr;
		}
	}
	/* Phones: a swipeable row instead of a tall stack of players. */
	@media (max-width: 43.99rem) {
		.reel {
			display: flex;
			gap: 1rem;
			margin-inline: calc(-1 * var(--gutter));
			padding: 0 var(--gutter) 1rem;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--gutter);
			-webkit-overflow-scrolling: touch;
		}
		.reel li {
			flex: none;
			width: min(82%, 20rem);
			scroll-snap-align: start;
		}
	}

	/* ---------- About ---------- */
	.about-grid {
