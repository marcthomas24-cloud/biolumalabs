---
import Page from '../layouts/Page.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL, PLAY_URL } from '../consts';
---

<Page title={`${SITE_TITLE} — games for curious kids`} description={SITE_DESCRIPTION}>
	<section class="hero">
		<img class="logo" src="/logo.svg" width="380" height="260" alt="Bioluma Labs" />
		<h1 class="sr-only">{SITE_TITLE}</h1>
		<p class="lede">{SITE_DESCRIPTION}</p>
	</section>

	<section class="card release" aria-labelledby="new-release">
		<p class="kicker">New release</p>
		<h2 id="new-release">Axolotl Odyssey</h2>
		<p>
			A swimming, digging, regrowing adventure starring an axolotl. Lose a leg to a crayfish and
			grow it back, just like a real <em>Ambystoma mexicanum</em>, then follow the water all the
			way to where it went.
		</p>
		<p class="muted small">Plays in the browser on iPad, tablet and computer. No sign-up, no ads.</p>
		<a class="button" href={PLAY_URL}>Play Axolotl Odyssey <span aria-hidden="true">→</span></a>
	</section>

	<section class="contact">
		<h2>Say hello</h2>
		<p>
			Questions, ideas or a bug to report? Email
			<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
		</p>
	</section>
</Page>

<style>
	.hero {
		text-align: center;
		margin-bottom: clamp(2rem, 6vw, 3rem);
	}
	.logo {
		display: block;
		width: min(100%, 22rem);
		height: auto;
		margin: 0 auto 0.5rem;
	}
	.lede {
		max-width: 30rem;
		margin: 0 auto;
	}
	.release h2 {
		margin-top: 0;
	}
	.kicker {
		margin: 0 0 0.4rem;
		color: var(--glow);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.small {
		font-size: 0.92rem;
	}
	.contact {
		text-align: center;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
