---
import Page from '../layouts/Page.astro';
import GameCard from '../components/GameCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL, PRODUCTS } from '../consts';

const featured = PRODUCTS.find((p) => p.featured) ?? PRODUCTS[0];
const others = PRODUCTS.filter((p) => p !== featured);
---

<Page title={`${SITE_TITLE} — designed by kids, engineered by adults`} description={SITE_DESCRIPTION} wide>
	<section class="hero">
		<img class="logo" src="/logo.svg" width="380" height="260" alt="BioLuma Labs" />
		<h1><span class="sr-only">{SITE_TITLE}. </span>Designed by kids.<br /> <span class="accent">Engineered by adults.</span></h1>
		<p class="lede">
			We make games and apps that start with big ideas — sometimes from the smallest members of
			the team.
		</p>
		<div class="ctas">
			{featured.playUrl && (
				<a class="button" href={featured.playUrl}>Play {featured.name} <span aria-hidden="true">→</span></a>
			)}
			<a class="ghost" href="#games">See all our games</a>
		</div>
	</section>

	<section id="games" class="section" aria-labelledby="games-title">
		<div class="section-head">
			<p class="eyebrow">Play in your browser</p>
			<h2 id="games-title">Our games</h2>
		</div>
		<GameCard product={featured} featured />
		{others.length > 0 && (
			<div class="grid">
				{others.map((p) => <GameCard product={p} />)}
			</div>
		)}
	</section>

	<section class="section lab" aria-labelledby="lab-title">
		<div class="bubbles" aria-hidden="true"><span></span><span></span><span></span></div>
		<p class="eyebrow">The Lab</p>
		<h2 id="lab-title">What's next?</h2>
		<p class="lab-intro">Here's what's bubbling away in the lab right now.</p>

		<article class="teaser" aria-labelledby="piglets-surgery">
			<a class="teaser-art" href="/art/piglets-surgery.webp" aria-label="See the Piglet's Surgery artwork full size">
				<img
					src="/art/piglets-surgery.webp"
					alt="Piglet's Surgery artwork: Dr Piglet, a pink plush pig in a white coat, operates on Bart the blobfish while Big Bunny the chief nurse covers her eyes, two owls called Choccy and Icey watch, and Raaaar the dinosaur knocks things over. Below, Piglet shouts 'Just give him a… SHHHOTTT!!!' at Pip the avocado, then does frantic CPR as things escalate quickly."
					width="1774"
					height="887"
					loading="lazy"
					decoding="async"
				/>
			</a>
			<div class="teaser-body">
				<p class="badge">In the lab</p>
				<h3 id="piglets-surgery">Piglet's Surgery</h3>
				<p class="teaser-tagline">The world's least relaxing doctor's surgery!</p>
				<p>
					Dr Piglet is very enthusiastic. Dr Piglet is also a bit risky. Examine some very
					strange patients, make questionable decisions with real (toy) equipment and keep the
					surgery running while Big Bunny, the long-suffering chief nurse, tries to hold it all
					together. Every choice can make things better… or much, much worse.
				</p>
				<p class="checklist" aria-label="How it goes">
					<span>Examine.</span> <span>Treat.</span> <span>Panic.</span> <span>(Maybe) save.</span>
				</p>
				<a class="button" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Piglet's Surgery tester")}`}>
					Be a test patient <span aria-hidden="true">→</span>
				</a>
				<p class="fine">Want to try it before anyone else? Drop us a line and we'll let you know when testing starts.</p>
			</div>
		</article>
	</section>

	<section id="about" class="section about" aria-labelledby="about-title">
		<p class="eyebrow">The studio</p>
		<h2 id="about-title">About BioLuma Labs</h2>
		<p class="big">BioLuma Labs is an independent game and app studio based in the UK.</p>
		<p>
			We make things because we think they're fun, interesting or useful. Some ideas come from
			us. Some come from our kids. Some start as a ridiculous conversation at the dinner table.
		</p>
		<p>
			Whatever the origin, we build them properly — and if they're good enough, we put them out
			into the world.
		</p>
		<ul class="values" aria-label="What we aim for">
			<li>Fun first</li>
			<li>Accessible</li>
			<li>Family-friendly</li>
			<li>Thoughtfully designed</li>
		</ul>
	</section>

	<section class="section contact" aria-labelledby="contact-title">
		<h2 id="contact-title">Say hello</h2>
		<p>
			Questions, ideas or a bug to report? Email
			<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
		</p>
	</section>
</Page>

<style>
	.hero {
		max-width: var(--measure);
		margin: 0 auto;
		text-align: center;
	}
	.logo {
		display: block;
		width: min(70%, 15rem);
		height: auto;
		margin: 0 auto 1.25rem;
	}
	h1 {
		margin: 0 0 0.9rem;
		font-size: clamp(1.6rem, 0.9rem + 3.6vw, 3.4rem);
		text-wrap: balance;
		line-height: 1.08;
		letter-spacing: -0.025em;
	}
	.accent {
		color: var(--glow);
		text-shadow: 0 0 28px rgba(124, 245, 208, 0.35);
	}
	.lede {
		max-width: 32rem;
		margin: 0 auto 1.5rem;
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem 1.25rem;
	}
	.ghost {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: 0 0.5rem;
		font-weight: 600;
	}

	.section {
		margin-top: clamp(3rem, 9vw, 5.5rem);
	}
	.section-head {
		margin-bottom: 1.25rem;
	}
	.eyebrow {
		margin: 0 0 0.3rem;
		color: var(--glow);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0 0 0.6rem;
		font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.1rem);
		letter-spacing: -0.02em;
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin-top: 1.25rem;
	}

	.lab {
		position: relative;
		overflow: hidden;
		padding: clamp(1.5rem, 5vw, 2.5rem);
		border: 1px dashed rgba(124, 245, 208, 0.28);
		border-radius: 1.25rem;
		background: radial-gradient(26rem 14rem at 100% 0%, rgba(240, 143, 187, 0.1), transparent 70%);
	}
	.lab-intro {
		margin: 0 0 1.25rem;
		max-width: 30rem;
		color: var(--muted);
	}
	.bubbles {
		display: none;
	}
	@media (min-width: 40rem) {
		.bubbles {
			display: block;
		}
	}

	/* A sneak peek at a game that isn't playable yet: no "Play now", just an
	   invitation to test it. The artwork is full of lettering, so it is shown
	   whole rather than cropped. */
	.teaser {
		position: relative;
		overflow: hidden;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 1rem;
	}
	.teaser-art {
		display: block;
		aspect-ratio: 2 / 1;
		background: var(--bg-2);
	}
	.teaser-art img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.teaser-body .badge {
		display: inline-block;
		margin: 0 0 0.6rem;
		padding: 0.2rem 0.7rem;
		border: 1px dashed rgba(124, 245, 208, 0.6);
		border-radius: 999px;
		color: var(--glow);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.teaser-body {
		padding: 1.1rem 1.1rem 1.35rem;
	}
	.teaser-body h3 {
		margin: 0 0 0.2rem;
		font-size: clamp(1.4rem, 1.15rem + 1.1vw, 1.9rem);
		line-height: 1.15;
	}
	.teaser-tagline {
		margin: 0 0 0.6rem;
		color: var(--pink);
		font-size: 1.1rem;
		font-weight: 650;
	}
	.teaser-body p {
		max-width: 40rem;
	}
	.teaser-body > p:not(.teaser-tagline, .badge) {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.checklist {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.9rem;
		margin: 0.9rem 0 1.1rem;
		font-weight: 700;
	}
	.checklist span::before {
		content: "✓ ";
		color: var(--glow);
	}
	.checklist span:nth-child(3) {
		color: var(--pink);
	}
	.teaser-body .fine {
		margin: 0.75rem 0 0;
		font-size: 0.85rem;
	}
	@media (min-width: 52rem) {
		.teaser-body {
			padding: 1.5rem 1.75rem 1.75rem;
		}
	}
	.bubbles span {
		position: absolute;
		border-radius: 50%;
		border: 2px solid rgba(124, 245, 208, 0.35);
		box-shadow: 0 0 14px rgba(124, 245, 208, 0.25);
		animation: rise 7s ease-in-out infinite;
	}
	.bubbles span:nth-child(1) { width: 1.1rem; height: 1.1rem; right: 14%; top: 4.5rem; }
	.bubbles span:nth-child(2) { width: 0.6rem; height: 0.6rem; right: 22%; top: 2.5rem; animation-delay: -2.5s; }
	.bubbles span:nth-child(3) { width: 1.7rem; height: 1.7rem; right: 7%; top: 1.5rem; animation-delay: -5s; border-color: rgba(240, 143, 187, 0.4); }
	@keyframes rise {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	.about {
		max-width: var(--measure);
	}
	.about .big {
		font-size: 1.15em;
		font-weight: 650;
	}
	.about p {
		color: var(--muted);
	}
	.about .big {
		color: var(--ink);
	}
	.values {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.values li {
		margin: 0;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		background: rgba(240, 143, 187, 0.1);
		border: 1px solid rgba(240, 143, 187, 0.25);
		color: var(--pink);
		font-size: 0.85rem;
		font-weight: 650;
	}

	.contact {
		text-align: center;
	}
</style>
