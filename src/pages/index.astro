---
import Page from '../layouts/Page.astro';
import CollectionTile from '../components/CollectionTile.astro';
import PlayPoster from '../components/PlayPoster.astro';
import {
	COMPANY,
	CONTACT_EMAIL,
	SITE_DESCRIPTION,
	SITE_TAGLINE,
	SITE_TITLE,
	SITE_URL,
} from '../consts';
import { GAMES, RELEASED, TANK_MORPHS, WITH_TRAILERS, gameUrl } from '../data/games';

const bySlug = (slug: string) => GAMES.find((g) => g.slug === slug)!;

// The homepage is curated by hand: games are grouped into families and the
// strongest artwork gets the biggest tile. Any released game not placed here
// still appears, in "More from the lab", so nothing is ever left out.
const axo = {
	chase: bySlug('axolotl-chase'),
	odyssey: bySlug('axolotl-odyssey'),
	colouring: bySlug('axolotl-colouring'),
	tank: bySlug('axolotl-tank'),
};
const capy = { sports: bySlug('capy-sports-club'), boarder: bySlug('capy-boarder') };
const placed = new Set([...Object.values(axo), ...Object.values(capy)].map((g) => g.slug));
const unplaced = RELEASED.filter((g) => !placed.has(g.slug));
const tank = axo.tank;

// The wall of artwork behind the hero: three slowly drifting columns.
const wall = [
	['axolotl-chase', 'capy-sports-club', 'axolotl-tank', 'axolotl-colouring'],
	['axolotl-odyssey', 'capy-boarder', 'axolotl-chase', 'capy-sports-club'],
	['axolotl-colouring', 'axolotl-tank', 'axolotl-odyssey', 'capy-boarder'],
].map((col) => col.map(bySlug));

// Trailers: one on the big screen, the rest queued beside it.
const [showing, ...queue] = [
	...WITH_TRAILERS.filter((g) => g.slug === 'axolotl-odyssey'),
	...WITH_TRAILERS.filter((g) => g.slug !== 'axolotl-odyssey'),
];
const tankShots = [tank.screenshots[2], tank.screenshots[1]].filter(Boolean);
const RARE = new Set(['gfp', 'mosaic']);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	legalName: COMPANY,
	url: SITE_URL,
	logo: `${SITE_URL}/favicon.svg`,
	email: CONTACT_EMAIL,
	description: SITE_DESCRIPTION,
};
---

<Page title={`${SITE_TITLE} | Family-made indie games. ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} jsonLd={jsonLd} wide>
	<!-- Hero -->
	<section class="hero on-dark">
		<div class="wall" aria-hidden="true">
			{wall.map((col, i) => (
				<div class={`wall-col col-${i + 1}`}>
					{[...col, ...col].map((g, j) => (
						<img src={g.artSmall} alt="" width="800" height="450" loading={j < 2 ? 'eager' : 'lazy'} decoding="async" />
					))}
				</div>
			))}
		</div>
		<div class="container hero-copy">
			<p class="eyebrow">Independent games studio · UK</p>
			<h1>Little worlds.<br /> <span class="accent">Big adventures.</span></h1>
			<p class="hero-lede">
				Original games and creative apps for curious minds and families. Made with imagination,
				built properly, and never full of ads.
			</p>
			<div class="hero-actions">
				<a class="btn btn--glow" href="#games">Explore our games <span aria-hidden="true">↓</span></a>
				<a class="btn btn--ghost" href="#coming-soon">Meet Axolotl Tank</a>
			</div>
			<div class="hero-note">
				<ul class="icon-stack" aria-hidden="true">
					{RELEASED.filter((g) => g.icon).map((g) => <li><img src={g.icon} width="48" height="48" alt="" /></li>)}
				</ul>
				<p><strong>{RELEASED.length} games and apps out now</strong><br />App Store, Google Play and the web. No ads, no accounts.</p>
			</div>
		</div>
	</section>

	<!-- Collection 01: the axolotl family -->
	<section id="games" class="section collection axo" aria-labelledby="axo-title">
		<div class="container">
			<header class="collection-head" data-reveal>
				<p class="eyebrow"><span class="no">01</span> The collection</p>
				<h2 id="axo-title">The Axolotl <span>family</span></h2>
				<p>Four very different ways to spend time with the world's smiliest amphibian: an epic adventure, a frantic arcade chase, a calm colouring book and a tank of your own.</p>
			</header>
			<div class="bento bento--axo">
				<div class="b-chase" data-reveal><CollectionTile game={axo.chase} size="hero" stretch focus="50% 40%" /></div>
				<div class="b-odyssey" data-reveal><CollectionTile game={axo.odyssey} /></div>
				<div class="b-colouring" data-reveal><CollectionTile game={axo.colouring} focus="0% 50%" /></div>
				<div class="b-tank" data-reveal><CollectionTile game={tank} size="strip" href="#coming-soon" cta="Coming soon · see it below" focus="70% 45%" /></div>
			</div>
		</div>
	</section>

	<!-- Collection 02: starring Capy -->
	<section class="section collection capy" aria-labelledby="capy-title">
		<div class="container">
			<header class="collection-head" data-reveal>
				<p class="eyebrow"><span class="no">02</span> The collection</p>
				<h2 id="capy-title">Starring <span>Capy</span></h2>
				<p>A very calm capybara with very big sporting dreams. Ten sports in one club, and a skateboard for the weekend.</p>
			</header>
			<div class="bento bento--capy">
				<div data-reveal><CollectionTile game={capy.sports} size="hero" /></div>
				<div data-reveal><CollectionTile game={capy.boarder} size="fill" focus="50% 70%" /></div>
			</div>
			{unplaced.length > 0 && (
				<div class="bento bento--more">
					{unplaced.map((g) => <div data-reveal><CollectionTile game={g} /></div>)}
				</div>
			)}
		</div>
	</section>

	<!-- Coming soon: Axolotl Tank -->
	<section id="coming-soon" class="soon on-dark" aria-labelledby="tank-title">
		<div class="soon-stage">
			<img
				class="soon-art"
				src={tank.art}
				alt={tank.artAlt}
				width={tank.artWidth}
				height={tank.artHeight}
				loading="lazy"
				decoding="async"
			/>
			<div class="rays" aria-hidden="true"></div>
			<div class="bubbles" aria-hidden="true">
				{Array.from({ length: 9 }, (_, i) => <span style={`--i: ${i}`}></span>)}
			</div>
			<div class="container soon-grid">
				<div class="soon-copy" data-reveal>
					<p class="soon-flags"><span class="flag flag--soon">Coming soon</span> <span class="soon-genre">{tank.genre}</span></p>
					<h2 id="tank-title" class="wordmark">Axolotl <span>Tank</span></h2>
					<p class="soon-headline">{tank.tagline}</p>
					<p class="soon-text">
						Hatch eggs, discover rare colour morphs and build an aquarium that's entirely yours.
						Feed, clean and play for a few minutes a day, and watch your axolotls grow.
					</p>
					<div class="soon-actions">
						<a class="btn btn--glow" href={gameUrl(tank)}>Take a first look <span aria-hidden="true">→</span></a>
						<a class="btn btn--ghost" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Tell me when Axolotl Tank is out')}`}>Tell me when it's out</a>
					</div>
				</div>
				<div class="phones" aria-hidden="true">
					{tankShots.map((s, i) => (
						<div class={`phone phone-${i + 1}`}>
							<img src={s.src} alt="" width={s.width} height={s.height} loading="lazy" decoding="async" />
						</div>
					))}
				</div>
			</div>
		</div>
		<div class="container hatch">
			<p class="hatch-title" data-reveal><strong>Eight colour morphs to hatch.</strong> Every one a colour real axolotls come in.</p>
			<ul class="morphs" aria-label="The axolotl colours to collect in Axolotl Tank" data-reveal>
				{TANK_MORPHS.map((m) => (
					<li class:list={{ rare: RARE.has(m.id.toLowerCase()) }}>
						<img src={m.src} alt="" width="640" height="360" loading="lazy" decoding="async" />
						<span>{m.name}</span>
						{RARE.has(m.id.toLowerCase()) && <em>Rare</em>}
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Trailers -->
	<section id="trailers" class="section watch on-dark" aria-labelledby="watch-title">
		<div class="container">
			<header class="section-head" data-reveal>
				<p class="eyebrow">Now showing</p>
				<h2 id="watch-title">Trailers</h2>
			</header>
			<div class="screen" data-reveal>
				<div class="screen-main" style={`--accent: ${showing.accent}`}>
					<PlayPoster trailer={showing.trailer!} image={showing.art} width={showing.artWidth} height={showing.artHeight} size="xl" caption={showing.name} />
				</div>
				<ol class="queue" aria-label="More trailers">
					{queue.map((g) => (
						<li style={`--accent: ${g.accent}`}>
							<a class="queue-item" href={`https://www.youtube.com/watch?v=${g.trailer!.id}`} data-video={g.trailer!.id} data-title={g.trailer!.title}>
								<span class="thumb">
									<img src={g.artSmall} alt="" width="800" height="450" loading="lazy" decoding="async" />
									<span class="mini-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
								</span>
								<span class="q-text">
									<span class="q-name">{g.name}</span>
									<span class="q-genre">{g.genre} · Trailer</span>
								</span>
							</a>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<!-- Also in the lab: Piglet's Surgery -->
	<section class="section lab" aria-labelledby="piglets-surgery">
		<div class="container">
			<article class="teaser" data-reveal>
				<a class="teaser-art" href="/art/piglets-surgery.webp" data-zoom aria-label="See the Piglet's Surgery artwork full size">
					<img
						src="/art/piglets-surgery.webp"
						alt="Piglet's Surgery artwork: Dr Piglet, a pink plush pig in a white coat, operates on Bart the blobfish while Big Bunny the chief nurse covers her eyes, two owls called Choccy and Icey watch, and Raaaar the dinosaur knocks things over. Below, Piglet shouts 'Just give him a… SHHHOTTT!!!' at Pip the avocado, then does frantic CPR as things escalate quickly."
						width="1774"
						height="887"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<div class="teaser-body">
					<p class="eyebrow">Also in the lab</p>
					<h2 id="piglets-surgery">Piglet's Surgery</h2>
					<p class="teaser-tagline">The world's least relaxing doctor's surgery!</p>
					<p>
						Dr Piglet is very enthusiastic. Dr Piglet is also a bit risky. Examine some very
						strange patients, make questionable decisions with real (toy) equipment and keep the
						surgery running while Big Bunny, the long-suffering chief nurse, tries to hold it all
						together. Every choice can make things better… or much, much worse.
					</p>
					<p class="checklist" aria-label="How it goes">
						<span>Examine.</span> <span>Treat.</span> <span>Panic.</span> <span>(Maybe) save.</span>
					</p>
					<a class="btn" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Piglet's Surgery tester")}`}>
						Be a test patient <span aria-hidden="true">→</span>
					</a>
					<p class="fine">Want to try it before anyone else? Drop us a line and we'll let you know when testing starts.</p>
				</div>
			</article>
		</div>
	</section>

	<!-- About -->
	<section id="about" class="section about" aria-labelledby="about-title">
		<div class="container about-grid">
			<div data-reveal>
				<p class="eyebrow">About us</p>
				<h2 id="about-title">Big ideas, imaginative worlds and games made for families.</h2>
				<p class="motto">Designed by kids. <span>Engineered by adults.</span></p>
			</div>
			<div class="about-copy" data-reveal>
				<p class="big">BioLuma Labs is a family-led independent games studio based in the UK.</p>
				<p>
					We make things because we think they're fun, interesting or useful. Some ideas come from
					us. Some come from our kids. Some start as a ridiculous conversation at the dinner table.
				</p>
				<p>
					Whatever the origin, we build them properly, and if they're good enough, we put them out
					into the world.
				</p>
				<ul class="values" aria-label="What we aim for">
					<li>Fun first</li>
					<li>Accessible</li>
					<li>Family-friendly</li>
					<li>Thoughtfully designed</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Contact -->
	<section id="contact" class="section contact" aria-labelledby="contact-title">
		<div class="container">
			<div class="contact-card on-dark" data-reveal>
				<img src="/favicon.svg" width="96" height="96" alt="" loading="lazy" />
				<div>
					<h2 id="contact-title">Say hello</h2>
					<p>
						Questions, ideas or a bug to report? Email us and a real person will reply.
					</p>
				</div>
				<div class="contact-actions">
					<a class="btn btn--glow" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
					<a class="btn btn--ghost" href="/support/">Get support</a>
				</div>
			</div>
		</div>
	</section>
</Page>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background:
			radial-gradient(50rem 30rem at 0% 0%, rgba(20, 167, 162, 0.28), transparent 65%),
			var(--navy-950);
		padding-block: clamp(3rem, 9vw, 7.5rem) clamp(5rem, 11vw, 8.5rem);
	}
	/* A slowly drifting wall of game artwork, fading into the night on the left. */
	.wall {
		position: absolute;
		z-index: -1;
		top: -30%;
		right: -8%;
		width: min(60rem, 66vw);
		height: 160%;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		transform: rotate(-10deg);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 34%);
		mask-image: linear-gradient(to right, transparent 0%, #000 34%);
		opacity: 0.95;
	}
	.wall::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, var(--navy-950) 0%, transparent 18%, transparent 80%, var(--navy-950) 100%);
	}
	.wall-col {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		animation: drift 70s linear infinite;
	}
	.col-2 {
		animation-direction: reverse;
		margin-top: -4rem;
	}
	.col-3 {
		animation-duration: 85s;
	}
	.wall-col img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 1rem;
		box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.8);
	}
	@keyframes drift {
		from { transform: translateY(0); }
		to { transform: translateY(calc(-50% - 0.5rem)); }
	}
	.hero-copy {
		position: relative;
	}
	.hero-copy > * {
		max-width: 34rem;
	}
	.hero-copy > h1 {
		max-width: 44rem;
	}
	.hero h1 {
		margin: 0 0 1.25rem;
		font-size: clamp(2.8rem, 1.4rem + 6.5vw, 5.75rem);
		line-height: 0.98;
		letter-spacing: -0.025em;
		text-shadow: 0 4px 30px rgba(5, 19, 32, 0.8);
	}
	.hero .accent {
		color: var(--glow);
		text-shadow: 0 0 40px rgba(124, 245, 208, 0.35);
	}
	.hero-lede {
		margin: 0 0 2rem;
		color: var(--on-dark);
		font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
		text-shadow: 0 2px 16px rgba(5, 19, 32, 0.9);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.hero-note {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 2.25rem;
	}
	.hero-note p {
		margin: 0;
		color: var(--on-dark-2);
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.hero-note strong {
		color: var(--on-dark);
	}
	.icon-stack {
		display: flex;
		flex: none;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.icon-stack li {
		margin: 0 0 0 -0.7rem;
	}
	.icon-stack li:first-child {
		margin-left: 0;
	}
	.icon-stack img {
		display: block;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 24%;
		border: 2px solid var(--navy-950);
		box-shadow: 0 6px 14px -4px rgba(0, 0, 0, 0.6);
	}
	/* Phones: the wall sits behind the copy as a dim texture. */
	@media (max-width: 47.99rem) {
		.hero {
			padding-bottom: 17rem;
		}
		.wall {
			top: auto;
			bottom: -6rem;
			right: -25%;
			width: 140%;
			height: 24rem;
			-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 35%);
			mask-image: linear-gradient(to bottom, transparent 0%, #000 35%);
		}
		.wall::after {
			display: none;
		}
	}

	/* ---------- Collections ---------- */
	/* The paper rises over the hero with a soft rounded edge. */
	.axo {
		position: relative;
		margin-top: calc(-1 * var(--radius-l));
		border-radius: var(--radius-l) var(--radius-l) 0 0;
		background: var(--paper);
	}
	.capy {
		padding-top: 0;
	}
	.collection-head {
		display: grid;
		gap: 0.25rem 3rem;
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}
	.collection-head h2 {
		margin: 0;
		font-size: clamp(2.2rem, 1.4rem + 3.6vw, 4rem);
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.axo .collection-head h2 span {
		color: var(--pink-deep);
	}
	.capy .collection-head h2 span {
		color: #6b3fd4;
	}
	.collection-head > p:last-child {
		max-width: 34rem;
		margin: 0;
		color: var(--ink-2);
		font-size: 1.05rem;
	}
	@media (min-width: 62rem) {
		.collection-head {
			grid-template-columns: auto 1fr;
			align-items: end;
		}
		.collection-head .eyebrow {
			grid-column: 1 / -1;
		}
		.collection-head > p:last-child {
			justify-self: end;
		}
	}
	.bento {
		display: grid;
		gap: 1.25rem;
	}
	.bento > div {
		display: grid;
		min-width: 0;
	}
	.bento--more {
		margin-top: 1.25rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
	}
	@media (min-width: 44rem) {
		.bento--axo {
			grid-template-columns: 1fr 1fr;
		}
		.b-chase,
		.b-tank {
			grid-column: 1 / -1;
		}
	}
	@media (min-width: 62rem) {
		.bento--axo {
			grid-template-columns: 1.45fr 1fr;
			grid-template-areas:
				"chase odyssey"
				"chase colouring"
				"tank tank";
		}
		.b-chase { grid-area: chase; }
		.b-odyssey { grid-area: odyssey; }
		.b-colouring { grid-area: colouring; }
		.b-tank { grid-area: tank; }
		.bento--capy {
			grid-template-columns: 1.45fr 1fr;
		}
	}

	/* ---------- Coming soon: Axolotl Tank ---------- */
	.soon {
		position: relative;
		overflow: hidden;
		background: #052a33;
		padding-bottom: clamp(3rem, 7vw, 5rem);
	}
	.soon-stage {
		position: relative;
		isolation: isolate;
	}
	.soon-art {
		display: block;
		width: 100%;
		height: clamp(16rem, 56vw, 26rem);
		object-fit: cover;
		object-position: 65% 40%;
	}
	.soon-stage::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent 30%, #052a33 clamp(16rem, 56vw, 26rem));
	}
	/* Sunbeams sweeping slowly through the water. */
	.rays {
		position: absolute;
		inset: 0 0 auto;
		height: 100%;
		z-index: 1;
		pointer-events: none;
		background: repeating-linear-gradient(105deg, transparent 0 6%, rgba(255, 250, 210, 0.07) 6% 9%, transparent 9% 15%);
		-webkit-mask-image: linear-gradient(to bottom, #000, transparent 70%);
		mask-image: linear-gradient(to bottom, #000, transparent 70%);
		animation: sway 14s ease-in-out infinite alternate;
	}
	@keyframes sway {
		from { transform: translateX(-3%); }
		to { transform: translateX(3%); }
	}
	.bubbles {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		overflow: hidden;
	}
	.bubbles span {
		position: absolute;
		bottom: -2rem;
		left: calc(8% + var(--i) * 10.5%);
		width: calc(0.4rem + (var(--i) * 3 % 5) * 0.22rem);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1.5px solid rgba(220, 255, 250, 0.55);
		background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.5), transparent 60%);
		animation: rise calc(9s + (var(--i) * 7 % 6) * 1s) linear infinite;
		animation-delay: calc(var(--i) * -1.7s);
	}
	@keyframes rise {
		from { transform: translate(0, 0); opacity: 0; }
		10% { opacity: 1; }
		50% { transform: translate(12px, -50vh); }
		to { transform: translate(-6px, -100vh); opacity: 0; }
	}
	.soon-grid {
		position: relative;
		z-index: 2;
		margin-top: -5rem;
	}
	.soon-flags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 0.9rem;
	}
