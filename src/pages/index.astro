---
import Page from '../layouts/Page.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL, PRODUCTS } from '../consts';
---

<Page title={`${SITE_TITLE} — designed by kids, engineered by adults`} description={SITE_DESCRIPTION}>
	<section class="hero">
		<img class="logo" src="/logo.svg" width="380" height="260" alt="Bioluma Labs" />
		<h1 class="sr-only">{SITE_TITLE}</h1>
		<p class="tagline">Designed by kids. Engineered by adults.</p>
		<p class="lede">
			Every Bioluma Labs game and app starts as an idea from our kids. A grown-up then does the
			careful engineering to make it real, safe and fun to use.
		</p>
	</section>

	{PRODUCTS.map((p) => (
		<section class="card release" aria-labelledby={p.id}>
			<div class="release-head">
				<img class="icon" src={p.icon} width="96" height="96" alt="" />
				<div>
					<p class="kicker">{p.kicker}</p>
					<h2 id={p.id}>{p.name}</h2>
				</div>
			</div>
			<p set:html={p.blurb} />
			<p class="muted small">Plays in the browser on iPad, tablet and computer. No sign-up, no ads.</p>
			<div class="actions">
				<a class="button" href={p.playUrl}>Play {p.name} <span aria-hidden="true">→</span></a>
				<ul class="stores" aria-label={`${p.name} in app stores`}>
					{[['App Store', p.appStore], ['Google Play', p.googlePlay]].map(([store, url]) =>
						url ? (
							<li><a class="store" href={url}>{store}</a></li>
						) : (
							<li><span class="store soon">{store} · coming soon</span></li>
						)
					)}
				</ul>
			</div>
		</section>
	))}

	<section class="contact">
		<h2>Say hello</h2>
		<p>
			Questions, ideas or a bug to report? Email
			<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
		</p>
	</section>
</Page>

<style>
	.hero {
		text-align: center;
		margin-bottom: clamp(2rem, 6vw, 3rem);
	}
	.logo {
		display: block;
		width: min(100%, 22rem);
		height: auto;
		margin: 0 auto 0.5rem;
	}
	.tagline {
		margin: 0 0 0.6rem;
		color: var(--glow);
		font-size: clamp(1.1rem, 3vw, 1.35rem);
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.lede {
		max-width: 30rem;
		margin: 0 auto;
	}
	.release + .release {
		margin-top: clamp(1.5rem, 4vw, 2rem);
	}
	.release h2 {
		margin: 0;
	}
	.release-head {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.icon {
		flex: none;
		width: clamp(4rem, 16vw, 6rem);
		height: auto;
		border-radius: 22%;
		border: 1px solid var(--line);
		box-shadow: 0 0 24px -6px rgba(94, 230, 190, 0.35);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
	}
	.stores {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.stores li {
		margin: 0;
	}
	.store {
		display: inline-block;
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.store.soon {
		color: var(--muted);
		opacity: 0.75;
	}
	.kicker {
		margin: 0 0 0.4rem;
		color: var(--glow);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.small {
		font-size: 0.92rem;
	}
	.contact {
		text-align: center;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
