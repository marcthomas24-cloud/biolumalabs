---
import { COMPANY, CONTACT_EMAIL } from '../consts';
---

<footer>
	<nav aria-label="Footer">
		<a href="/privacy/">Privacy</a>
		<a href="/support/">Support</a>
		<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	</nav>
	<p>&copy; 2026 {COMPANY}. All rights reserved.</p>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
		padding: 2rem max(1rem, env(safe-area-inset-left)) calc(2.5rem + env(safe-area-inset-bottom));
		text-align: center;
		color: var(--muted);
		font-size: 0.9rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 1rem;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.25rem;
		color: var(--muted);
	}
	nav a:hover {
		color: var(--glow);
	}
	p {
		margin: 0.75rem 0 0;
	}
</style>
