---
import { COMPANY, COMPANY_DETAILS, CONTACT_EMAIL, SITE_TITLE } from '../consts';
---

<footer>
	<nav aria-label="Footer">
		<a href="/privacy/">Privacy</a>
		<a href="/support/">Support</a>
		<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	</nav>
	<p>&copy; 2026 {COMPANY} t/a {SITE_TITLE}. All rights reserved.</p>
	<p class="legal">{SITE_TITLE} is a trading name of {COMPANY}. {COMPANY_DETAILS}</p>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
		padding: 2rem max(1rem, env(safe-area-inset-left)) calc(2.5rem + env(safe-area-inset-bottom));
		text-align: center;
		color: var(--muted);
		font-size: 0.9rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 1rem;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.25rem;
		color: var(--muted);
	}
	nav a:hover {
		color: var(--glow);
	}
	p {
		margin: 0.75rem 0 0;
		font-size: 0.75rem;
	}
	.legal {
		margin-top: 0.4rem;
		font-size: 0.625rem;
		line-height: 1.4;
		opacity: 0.75;
	}
</style>
