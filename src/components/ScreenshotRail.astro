---
import type { Screenshot } from '../data/games';

interface Props {
	shots: Screenshot[];
	label: string;
}

const { shots, label } = Astro.props;

// Portrait shots taken on different phones come in slightly different shapes.
// When they're mixed, give them all the median shape so the rail reads as one
// even row. Each one opens uncropped in the viewer.
const tall = shots.filter((s) => s.height > s.width).map((s) => s.width / s.height).sort((a, b) => a - b);
const mixed = tall.length > 1 && tall[tall.length - 1] - tall[0] > 0.02;
const median = tall[Math.floor(tall.length / 2)];
const ratio = (s: Screenshot) => (mixed && s.height > s.width ? `${median}` : `${s.width} / ${s.height}`);
---

<ul class="rail" aria-label={label} tabindex="0">
	{shots.map((s) => (
		<li style={`aspect-ratio: ${ratio(s)}`} class:list={{ tall: s.height > s.width }}>
			<a href={s.src} data-zoom>
				<img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
			</a>
		</li>
	))}
</ul>

<style>
	.rail {
		--h: clamp(13rem, 34vw, 21rem);
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0.5rem var(--gutter) 1.5rem;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		scroll-padding-inline: var(--gutter);
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: rgba(11, 34, 54, 0.3) transparent;
	}
	/* Line the first shot up with the page's content column on wide screens. */
	@media (min-width: 80rem) {
		.rail {
			padding-inline: calc((100vw - var(--wide)) / 2);
			scroll-padding-inline: calc((100vw - var(--wide)) / 2);
		}
	}
	li {
		flex: none;
		height: var(--h);
		margin: 0;
		scroll-snap-align: start;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--paper-2);
		box-shadow: var(--shadow-1);
	}
	li.tall {
		height: calc(var(--h) * 1.45);
	}
	.rail:has(li.tall) li:not(.tall) {
		align-self: center;
	}
	a {
		display: block;
		height: 100%;
		cursor: zoom-in;
	}
	img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}
	a:hover img {
		transform: scale(1.03);
	}
	a:focus-visible {
		outline-offset: -4px;
	}
</style>
