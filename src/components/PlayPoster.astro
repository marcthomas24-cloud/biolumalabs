---
import type { Trailer } from '../data/games';

interface Props {
	trailer: Trailer;
	/** Use another image (for example the game's key art) instead of the trailer thumbnail. */
	image?: string;
	width?: number;
	height?: number;
	eager?: boolean;
	/** Show a "Watch the trailer" label beside the play button. */
	label?: boolean;
	size?: 'm' | 'l';
}

const { trailer, image, width = 1280, height = 720, eager = false, label = false, size = 'm' } = Astro.props;
---

<a
	class:list={['poster', `size-${size}`]}
	href={`https://www.youtube.com/watch?v=${trailer.id}`}
	data-video={trailer.id}
	data-title={trailer.title}
	aria-label={`Play the ${trailer.title}`}
>
	<img
		src={image ?? trailer.poster}
		alt=""
		width={width}
		height={height}
		loading={eager ? 'eager' : 'lazy'}
		decoding="async"
	/>
	<span class="play" aria-hidden="true">
		<span class="disc">
			<svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
		</span>
		{label && <span class="text">Watch the trailer</span>}
	</span>
</a>

<style>
	.poster {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: inherit;
		background: var(--navy-800);
		color: #fff;
		text-decoration: none;
	}
	img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.poster::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(5, 19, 32, 0.55), transparent 55%);
		transition: opacity 0.3s ease;
	}
	.play {
		position: absolute;
		left: 1rem;
		bottom: 1rem;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		font-family: var(--font-display);
		font-weight: 600;
	}
	.disc {
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		background: #fff;
		color: var(--navy-900);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
		transition: transform 0.2s ease, background-color 0.2s ease;
	}
	.disc svg {
		margin-left: 3px;
	}
	.size-l .disc {
		width: 4.25rem;
		height: 4.25rem;
	}
	.size-l .play {
		left: 1.25rem;
		bottom: 1.25rem;
		font-size: 1.1rem;
	}
	.text {
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
	}
	.poster:hover img,
	.poster:focus-visible img {
		transform: scale(1.04);
	}
	.poster:hover .disc,
	.poster:focus-visible .disc {
		transform: scale(1.1);
		background: var(--glow);
	}
</style>
