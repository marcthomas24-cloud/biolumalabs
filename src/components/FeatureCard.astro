---
import type { Game } from '../data/games';
import { gameUrl } from '../data/games';
import PlayPoster from './PlayPoster.astro';
import StoreLinks from './StoreLinks.astro';

interface Props {
	game: Game;
	/** The lead card is larger and loads its artwork first. */
	lead?: boolean;
}

const { game: g, lead = false } = Astro.props;
---

<article class:list={['feature', { lead }]} style={`--accent: ${g.accent}`} aria-labelledby={`feature-${g.slug}`}>
	<div class="media">
		{g.trailer ? (
			<PlayPoster trailer={g.trailer} image={lead ? g.art : g.artSmall} width={lead ? g.artWidth : 800} height={lead ? g.artHeight : 450} label size={lead ? 'l' : 'm'} />
		) : (
			<a class="still" href={gameUrl(g)} tabindex="-1" aria-hidden="true">
				<img src={lead ? g.art : g.artSmall} alt="" width={lead ? g.artWidth : 800} height={lead ? g.artHeight : 450} loading="lazy" decoding="async" />
			</a>
		)}
		{g.isNew && <span class="flag">New</span>}
	</div>
	<div class="body">
		<div class="head">
			{g.icon && <img class="icon" src={g.icon} width="64" height="64" alt="" loading="lazy" decoding="async" />}
			<div>
				<p class="genre">{g.genre}</p>
				<h3 id={`feature-${g.slug}`}><a href={gameUrl(g)}>{g.name}</a></h3>
			</div>
		</div>
		<p class="tagline">{g.tagline}</p>
		<p class="summary">{g.summary}</p>
		{lead && g.screenshots.length >= 3 && (
			<ul class="peek" aria-label={`${g.name} screenshots`}>
				{g.screenshots.slice(0, 3).map((s) => (
					<li>
						<a href={s.src} data-zoom>
							<img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
						</a>
					</li>
				))}
			</ul>
		)}
		{lead && (
			<ul class="points">
				{g.features.slice(0, 3).map((f) => <li>{f.title}</li>)}
			</ul>
		)}
		<div class="actions">
			<a class="btn btn--small" href={gameUrl(g)}>
				View {g.kind.toLowerCase()}<span class="sr-only">: {g.name}</span> <span aria-hidden="true">→</span>
			</a>
			{g.googlePlay && (
				<a class="btn btn--small btn--ghost" href={g.googlePlay} rel="noopener">
					Google Play<span class="sr-only">: get {g.name}</span>
				</a>
			)}
			{!g.googlePlay && g.playUrl && (
				<a class="btn btn--small btn--ghost" href={g.playUrl}>
					Play now<span class="sr-only">: {g.name} in your browser</span>
				</a>
			)}
		</div>
	</div>
</article>

<style>
	.feature {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-1);
		transition: box-shadow 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	@media (hover: hover) {
		.feature:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow-2);
		}
	}
	.media {
		position: relative;
		background: var(--accent);
	}
	.still {
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	.still img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.feature:hover .still img {
		transform: scale(1.04);
	}
	.flag {
		position: absolute;
		top: 1rem;
		left: 1rem;
		z-index: 1;
	}
	.body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.25rem 1.35rem 1.5rem;
	}
	.head {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin-bottom: 0.75rem;
	}
	.icon {
		flex: none;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 22%;
		box-shadow: 0 6px 16px -6px rgba(11, 34, 54, 0.45);
	}
	.genre {
		margin: 0 0 0.1rem;
		color: var(--accent);
		filter: brightness(0.82);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	h3 {
		margin: 0;
		font-size: 1.5rem;
	}
	h3 a {
		color: var(--ink);
		text-decoration: none;
	}
	h3 a:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 3px;
	}
	.tagline {
		margin: 0 0 0.3rem;
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 500;
	}
	.summary {
		margin: 0 0 1.25rem;
		color: var(--ink-2);
		font-size: 0.97rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: auto;
	}

	.peek {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}
	.peek li {
		margin: 0;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-s);
		overflow: hidden;
		background: var(--paper-2);
	}
	.peek a {
		display: block;
		height: 100%;
		cursor: zoom-in;
	}
	.peek img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}
	.peek a:hover img {
		transform: scale(1.06);
	}

	.points {
		display: grid;
		gap: 0.35rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
		font-weight: 600;
	}
	.points li {
		position: relative;
		margin: 0;
		padding-left: 1.6rem;
	}
	.points li::before {
		content: "";
		position: absolute;
		left: 0.15rem;
		top: 0.5em;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--accent);
	}

	.lead h3 {
		font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.4rem);
	}
	.lead .tagline {
		font-size: 1.25rem;
	}
	@media (min-width: 62rem) {
		.lead .body {
			padding: 1.75rem 2rem 2rem;
		}
		.lead .icon {
			width: 4.25rem;
			height: 4.25rem;
		}
	}
</style>
