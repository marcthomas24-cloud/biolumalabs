---
interface Props {
	/** The YouTube video id. */
	id: string;
	title: string;
	poster: string;
}

const { id, title, poster } = Astro.props;
---

<!--
	Nothing is requested from YouTube until the viewer presses play: the poster is
	our own copy of the thumbnail, and the player is only added on click, from the
	no-cookie domain. Without JavaScript the button is a plain link to the video.
-->
<section class="trailer" aria-labelledby={`trailer-${id}`}>
	<h3 id={`trailer-${id}`} class="sr-only">{title}</h3>
	<div class="frame" data-video={id} data-title={title}>
		<a class="poster" href={`https://www.youtube.com/watch?v=${id}`} aria-label={`Play the ${title}`}>
			<img src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />
			<span class="play" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
			</span>
		</a>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.trailer .frame').forEach((frame) => {
		const link = frame.querySelector('a.poster');
		link?.addEventListener('click', (e) => {
			if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey) return;
			e.preventDefault();
			const f = document.createElement('iframe');
			f.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
			f.title = frame.dataset.title ?? 'Video';
			f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			f.allowFullscreen = true;
			f.referrerPolicy = 'strict-origin-when-cross-origin';
			frame.replaceChildren(f);
			f.focus();
		});
	});
</script>

<style>
	.trailer {
		margin-top: 1.25rem;
	}
	.frame {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--bg-2);
		border: 1px solid var(--line);
		border-radius: 1.25rem;
		box-shadow: 0 0 40px -14px rgba(94, 230, 190, 0.25);
	}
	.poster,
	.frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.poster {
		display: block;
	}
	.poster img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: rgba(5, 19, 31, 0.72);
		border: 2px solid var(--glow);
		color: var(--glow);
		box-shadow: 0 0 30px rgba(124, 245, 208, 0.4);
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.play svg {
		margin-left: 3px;
	}
	.poster:hover .play,
	.poster:focus-visible .play {
		transform: translate(-50%, -50%) scale(1.08);
		background: rgba(5, 19, 31, 0.9);
	}
</style>
