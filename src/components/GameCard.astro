---
import type { Game } from '../data/games';
import { gameUrl, soonLabel } from '../data/games';

interface Props {
	game: Game;
}

const { game: g } = Astro.props;
const upcoming = g.status === 'upcoming';
const where = [
	g.googlePlay && 'Google Play',
	g.appStore && 'App Store',
	g.playUrl && 'Browser',
].filter(Boolean);
---

<article class="game-card" style={`--accent: ${g.accent}`}>
	<div class="art">
		<img src={g.artSmall} alt="" width="800" height="450" loading="lazy" decoding="async" />
		{g.isNew && <span class="flag">New</span>}
		{upcoming && <span class="flag flag--soon">{soonLabel(g)}</span>}
	</div>
	<div class="body">
		{g.icon && <img class="icon" src={g.icon} width="56" height="56" alt="" loading="lazy" decoding="async" />}
		<p class="genre">{g.genre}</p>
		<h3><a href={gameUrl(g)}>{g.name}</a></h3>
		<p class="tagline">{g.tagline}</p>
		<p class="where">
			{upcoming ? (
				<span>In development</span>
			) : (
				where.map((w) => <span>{w}</span>)
			)}
			<span class="go" aria-hidden="true">→</span>
		</p>
	</div>
</article>

<style>
	.game-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: var(--shadow-1);
		transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.25s ease;
	}
	.art {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--accent);
	}
	.art img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.flag {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
	}
	.body {
		position: relative;
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.1rem 1.2rem 1.15rem;
		border-top: 4px solid var(--accent);
	}
	.icon {
		position: absolute;
		top: -2rem;
		right: 1.1rem;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 22%;
		border: 3px solid var(--surface);
		background: var(--surface);
		box-shadow: 0 6px 16px -6px rgba(11, 34, 54, 0.5);
	}
	.genre {
		margin: 0 0 0.2rem;
		padding-right: 4rem;
		color: var(--ink-2);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	h3 {
		margin: 0 0 0.3rem;
		font-size: 1.4rem;
	}
	/* The whole card is the link; the title carries its name. */
	h3 a {
		color: var(--ink);
		text-decoration: none;
	}
	h3 a::after {
		content: "";
		position: absolute;
		inset: -100vh 0 0;
		z-index: 1;
	}
	.game-card:has(a:focus-visible) {
		outline: 3px solid var(--teal-500);
		outline-offset: 3px;
	}
	h3 a:focus-visible {
		outline: none;
	}
	.tagline {
		margin: 0 0 1rem;
		color: var(--ink-2);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.where {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.9rem;
		margin: auto 0 0;
		color: var(--ink-2);
		font-size: 0.8rem;
		font-weight: 650;
	}
	.where span:not(.go)::before {
		content: "";
		display: inline-block;
		width: 0.45rem;
		height: 0.45rem;
		margin-right: 0.4rem;
		border-radius: 50%;
		background: var(--accent);
		vertical-align: 0.08em;
	}
	.go {
		margin-left: auto;
		color: var(--accent);
		font-size: 1.2rem;
		line-height: 1;
		transition: transform 0.2s ease;
	}
	@media (hover: hover) {
		.game-card:hover {
			transform: translateY(-5px);
			box-shadow: var(--shadow-2);
		}
		.game-card:hover .art img {
			transform: scale(1.05);
		}
		.game-card:hover .go {
			transform: translateX(4px);
		}
	}
</style>
