---
// One shared pop-up player for the whole page. Links marked with
// data-video="<YouTube id>" play their trailer in it; links marked with
// data-zoom show their image at full size.
//
// Nothing is requested from YouTube until the viewer presses play: posters are
// our own copies of the thumbnails, and the player is only created on click,
// from the no-cookie domain. Without JavaScript every link still works as a
// plain link to the video or the image.
---

<dialog class="viewer" id="viewer">
	<div class="stage"></div>
	<button class="close" type="button" aria-label="Close">
		<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
	</button>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('#viewer');
	const stage = dialog?.querySelector<HTMLElement>('.stage');

	if (dialog && stage && typeof dialog.showModal === 'function') {
		const open = (node: HTMLElement, kind: string, label: string) => {
			stage.replaceChildren(node);
			dialog.dataset.kind = kind;
			dialog.setAttribute('aria-label', label);
			dialog.showModal();
		};

		document.addEventListener('click', (e) => {
			if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
			const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-video], a[data-zoom]');
			if (!link) return;
			e.preventDefault();

			if (link.dataset.video) {
				const f = document.createElement('iframe');
				f.src = `https://www.youtube-nocookie.com/embed/${link.dataset.video}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
				f.title = link.dataset.title ?? 'Video';
				f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
				f.allowFullscreen = true;
				f.referrerPolicy = 'strict-origin-when-cross-origin';
				open(f, 'video', f.title);
			} else {
				const img = document.createElement('img');
				img.src = link.href;
				img.alt = link.querySelector('img')?.alt ?? '';
				open(img, 'image', img.alt || 'Screenshot');
			}
		});

		dialog.querySelector('.close')?.addEventListener('click', () => dialog.close());
		// A click on the dimmed area around the player closes it.
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
		// Removing the player stops the video.
		dialog.addEventListener('close', () => stage.replaceChildren());
	}
</script>

<style>
	.viewer {
		width: 100vw;
		max-width: 100vw;
		height: 100vh;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0;
		padding: max(3.75rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-left)) 1.5rem;
		border: 0;
		background: transparent;
		overflow: hidden;
	}
	.viewer[open] {
		display: grid;
		place-items: center;
	}
	.viewer::backdrop {
		background: rgba(3, 12, 22, 0.9);
	}
	.stage {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.stage :global(iframe) {
		pointer-events: auto;
		width: min(100%, calc((100dvh - 6rem) * 16 / 9));
		aspect-ratio: 16 / 9;
		border: 0;
		border-radius: var(--radius-s);
		background: #000;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
	}
	.stage :global(img) {
		pointer-events: auto;
		max-width: 100%;
		max-height: calc(100dvh - 6rem);
		width: auto;
		height: auto;
		border-radius: var(--radius-s);
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
	}
	.close {
		position: absolute;
		top: max(0.6rem, env(safe-area-inset-top));
		right: max(0.6rem, env(safe-area-inset-right));
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(234, 251, 245, 0.14);
		color: #fff;
		cursor: pointer;
	}
	.close:hover {
		background: rgba(234, 251, 245, 0.28);
	}
	.close:focus-visible {
		outline-color: var(--glow);
	}
	.close path {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
	}
</style>
